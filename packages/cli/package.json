{
  "name": "@weibot/cli",
  "version": "1.1.0",
  "description": "WEIBOT CLI - standalone multi-platform article publisher",
  "main": "dist/index.js",
  "bin": {
    "weibot": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "weibot",
    "markdown",
    "zhihu",
    "juejin",
    "csdn",
    "publish",
    "article",
    "ai"
  ],
  "author": "fun",
  "license": "MIT",
  "dependencies": {
    "@weibot/core": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "juice": "^11.1.1",
    "open": "^10.1.0",
    "ora": "^8.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2"
  }
}
